# LOCAL DEVELOPMENT ONLY. Copy to .env (gitignored) and fill in.
#
#     cp .env.example .env
#
# This file is for running seed.py and uvicorn on your own machine. It is never
# uploaded anywhere: .env is gitignored, so it is not in the repo and not in a
# Vercel build.
#
# On Vercel, set these in Project Settings -> Environment Variables instead,
# then redeploy — environment variables do not apply to existing deployments.
# A real environment variable always wins over this file, so the deployed value
# can never be shadowed by a stale local copy.
#
# Never commit the real values.

# ---------------------------------------------------------------- database
# Postgres. Neon, Vercel Postgres, Supabase or a local server all work.
# In serverless, use the POOLED connection string: every invocation opens its
# own connection and a direct endpoint runs out under real concurrency.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Scratch database for the stage and monthly tests. Each test drops and
# recreates the public schema, so this must NOT point at anything you care
# about — give it its own database, not just its own schema.
# TEST_DATABASE_URL=postgresql://user:password@host/adhoc_test?sslmode=require

# Set to 1 once the schema exists to skip the cold-start migration round trip.
# ADHOC_SKIP_MIGRATE=1

# Dev-only. Irrelevant on Vercel Services, where both services share a domain.
# ADHOC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ------------------------------------------------------------ usage source
# Where a month's usage comes from: 'keboola' (the Seso Prod warehouse) or
# 'upload' (rows already staged via /api/ingest/raw-file). Defaults to keboola.
ADHOC_USAGE_SOURCE=keboola

# Read-only Snowflake credentials for the Keboola-managed warehouse. Without
# these the keboola source reports itself unavailable and refuses to run rather
# than returning an empty month. The query lives in
# backend/app/sources/adhoc_usage.sql.
# SNOWFLAKE_ACCOUNT=xxxxx-yyyyy
# SNOWFLAKE_USER=adhoc_billing_ro
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=KEBOOLA_PROD
# SNOWFLAKE_DATABASE=SAPI_10112
# SNOWFLAKE_ROLE=

# Refuse to persist a month larger than this. A guard against a broken date
# filter, not a real limit — June 2026 was 656 rows.
# ADHOC_MAX_SOURCE_ROWS=200000


# --------------------------------------------------------- authentication
# Google OIDC, restricted to one hosted domain. Price confirmations and Good to
# Bill approvals record the signed-in user, so without these the app still
# serves the numbers but those two actions are disabled.
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# ADHOC_ALLOWED_DOMAIN=sesolabor.com

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out, which is the intended way to revoke sessions.
# ADHOC_SESSION_SECRET=

# Session lifetime in seconds (default 12 hours).
# ADHOC_SESSION_TTL=43200

# Who may reopen a closed period and edit mappings. Comma-separated.
# ADHOC_ADMIN_EMAILS=hannah.alvarado@sesolabor.com

# Only set if the redirect URI cannot be derived from the request host.
# ADHOC_OAUTH_REDIRECT_URI=https://adhoc-billing.vercel.app/api/auth/callback

# LOCAL ONLY — skips Google entirely and treats you as this user. Requires BOTH
# variables, so setting one by accident cannot open the app. Never set on Vercel.
# ADHOC_DEV_AUTH=1
# ADHOC_DEV_USER=you@sesolabor.com

# Browsers refuse Secure cookies over plain http://localhost, so sign-in fails
# locally with no visible reason unless this is set. Never set it in production.
# ADHOC_INSECURE_COOKIES=1


# ------------------------------------------------------------------- Slack
# Bot token from a Slack app (xoxb-...). Scopes: chat:write. Add chat:write.public
# or invite the bot to the channel. See README for the full setup.
# SLACK_BOT_TOKEN=xoxb-

# Where the real monthly notification goes, and the dev channel that replaces it
# in any non-live mode.
# SLACK_CHANNEL_ID=C0123456789
# SLACK_DEV_CHANNEL_ID=C9876543210

# The @csms user group and the person to tag. Only used in live mode.
#   group id:  Slack > user group > URL ends /S0123ABCD, or usergroups.list
#   user id:   profile > More > Copy member ID
# SLACK_CSM_GROUP_ID=S0123ABCD
# SLACK_NOTIFY_USER_ID=U0123ABCD

# dry_run (default) renders the message and calls Slack not at all.
# dev      posts to SLACK_DEV_CHANNEL_ID with every mention turned into plain
#          text, so it pings nobody.
# live     the real thing, and additionally requires SLACK_ALLOW_LIVE=1 so
#          promoting an environment takes two deliberate changes.
SLACK_MODE=dry_run
# SLACK_ALLOW_LIVE=1

# Link included in the notification.
# ADHOC_APP_URL=https://adhoc-billing.vercel.app


# -------------------------------------------------------------------- cron
# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`.
# Without it /api/cron/monthly refuses every request.
# CRON_SECRET=

# The scheduled job additionally refuses to run unless this is exactly 1.
# Leave unset until the monthly workflow has been validated by hand, and note
# that vercel.json has no `crons` entry either — both have to change.
# ADHOC_CRON_ENABLED=1
