# ── Sensitive data ─────────────────────────────────────────────
# Real billing extracts: worker names, Seso worker IDs, customer
# names, Salesforce account IDs, contract IDs, prices. Never commit.
backend/data/*.json
backend/data/*.csv
backend/data/*.xlsx

# SQLite (regenerate with: python seed.py --reset)
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm

# Secrets / local config
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ── Node ───────────────────────────────────────────────────────
node_modules/
dist/
.vite/
npm-debug.log*

